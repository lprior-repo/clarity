{
  "name": "clarity-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for Clarity desktop application",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "docker:build": "docker build -t clarity-e2e .",
    "docker:run": "docker run --rm clarity-e2e",
    "docker:test": "docker run --rm --network host clarity-e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
