{
  "session": "bd-2391.2",
  "module": "clarity-client/src/shared/mental_lattice/inversion.rs",
  "description": "First Principle: Avoid stupidity - cognitive biases and systematic methods to avoid stupid decisions",
  
  "types_to_create": [
    {
      "name": "CognitiveBias",
      "kind": "enum",
      "description": "Types of cognitive biases that affect decisions",
      "variants": [
        "ConfirmationBias",
        "AvailabilityHeuristic", 
        "Anchoring",
        "RecencyBias",
        "SurvivorshipBias",
        "SunkCostFallacy",
        "GamblerFallacy",
        "OverconfidenceBias",
        "DunningKruger",
        "PlanningFallacy",
        "BandwagonEffect",
        "AuthorityBias",
        "Groupthink",
        "HindsightBias",
        "FalseConsensus",
        "AttributionError"
      ]
    },
    {
      "name": "BiasSeverity",
      "kind": "enum",
      "description": "How severe a bias impact is",
      "variants": ["Low", "Moderate", "High", "Critical"]
    },
    {
      "name": "AntiStupidityMethod",
      "kind": "enum", 
      "description": "Systematic methods to avoid stupid decisions",
      "variants": [
        "InversionThinking",
        "PreMortem",
        "ReverseBrainstorming",
        "RedTeaming",
        "SteelManning",
        "NullHypothesis",
        "FalsificationTest",
        "BaseRateCheck",
        "OutsideView",
        "SecondOrderThinking",
        "IncentiveAudit",
        "AssumptionAudit"
      ]
    },
    {
      "name": "BiasDetection",
      "kind": "struct",
      "description": "Detected cognitive bias in a decision",
      "fields": [
        "id: Uuid",
        "bias_type: CognitiveBias", 
        "description: String",
        "severity: BiasSeverity",
        "evidence: String",
        "mitigation: Option<String>",
        "detected_at: DateTime<Utc>"
      ]
    },
    {
      "name": "AntiStupidityExercise",
      "kind": "struct",
      "description": "Systematic method to avoid stupid decisions",
      "fields": [
        "id: Uuid",
        "method: AntiStupidityMethod",
        "context: String",
        "findings: Vec<String>",
        "actions: Vec<String>",
        "confidence_score: f32",
        "created_at: DateTime<Utc>"
      ]
    },
    {
      "name": "InversionReview",
      "kind": "struct",
      "description": "Complete decision review with inversion analysis",
      "fields": [
        "id: Uuid",
        "decision_context: String",
        "detected_biases: Vec<BiasDetection>",
        "exercises: Vec<AntiStupidityExercise>",
        "stupidity_risk_score: f32",
        "recommendations: Vec<String>",
        "created_at: DateTime<Utc>",
        "updated_at: DateTime<Utc>"
      ]
    },
    {
      "name": "InversionError",
      "kind": "enum",
      "description": "Errors for inversion domain",
      "variants": [
        "EmptyField(String)",
        "InvalidSeverity(String)",
        "InvalidScore(f32)"
      ]
    }
  ],
  
