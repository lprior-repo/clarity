pub fn validate_spec_complex_dependencies_no_circular_test() {
  let behaviors = [
    make_behavior("a", [], "GET", "/a", dict.new()),
    make_behavior("b", ["a"], "GET", "/b", dict.new()),
    make_behavior("c", ["a"], "GET", "/c", dict.new()),
