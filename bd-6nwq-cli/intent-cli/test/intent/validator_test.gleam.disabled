import gleam/dict
import gleam/json
import gleam/list
import gleam/string
import gleeunit/should
import intent/types
import intent/validator

// =============================================================================
// Valid Spec Tests
// =============================================================================

pub fn validate_spec_empty_test() {
  let spec = make_minimal_spec([])

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_single_behavior_test() {
  let behavior = make_behavior("get_user", [], "GET", "/users/1", dict.new())
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_multiple_behaviors_test() {
  let behaviors = [
    make_behavior("login", [], "POST", "/auth/login", dict.new()),
    make_behavior("get_profile", [], "GET", "/profile", dict.new()),
    make_behavior("logout", [], "POST", "/auth/logout", dict.new()),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

// =============================================================================
// Variable Reference Tests
// =============================================================================

pub fn validate_spec_with_valid_captures_test() {
  let behaviors = [
    make_behavior_with_capture("create_user", [], "POST", "/users", "user_id"),
    make_behavior("get_user", [], "GET", "/users/${user_id}", dict.new()),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_with_missing_capture_test() {
  let behavior =
    make_behavior("get_user", [], "GET", "/users/${user_id}", dict.new())
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(1)
      case list.first(issues) {
        Ok(validator.MissingCapture(_, _, _, _)) -> Nil
        _ -> should.fail()
      }
    }
    _ -> should.fail()
  }
}

pub fn validate_spec_with_multiple_missing_captures_test() {
  let behavior =
    make_behavior("get_data", [], "GET", "/api/${id}/${version}", dict.new())
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(2)
      // Both id and version are missing
    }
    _ -> should.fail()
  }
}

pub fn validate_spec_capture_order_matters_test() {
  // Using ${token} before it's captured should fail
  let behaviors = [
    make_behavior("get_profile", [], "GET", "/profile/${token}", dict.new()),
    make_behavior_with_capture("login", [], "POST", "/auth/login", "token"),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(1)
      case list.first(issues) {
        Ok(validator.MissingCapture(_, _, "token", _)) -> Nil
        _ -> should.fail()
      }
    }
    _ -> should.fail()
  }
}

pub fn validate_spec_capture_in_headers_test() {
  let behaviors = [
    make_behavior_with_capture("login", [], "POST", "/auth/login", "auth_token"),
    make_behavior_with_header(
      "get_profile",
      [],
      "GET",
      "/profile",
      "Authorization",
      "Bearer ${auth_token}",
    ),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_missing_capture_in_headers_test() {
  let behavior =
    make_behavior_with_header(
      "get_profile",
      [],
      "GET",
      "/profile",
      "X-Token",
      "${missing_token}",
    )
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(1)
      case list.first(issues) {
        Ok(validator.MissingCapture(_, "request.headers", "missing_token", _)) ->
          Nil
        _ -> should.fail()
      }
    }
    _ -> should.fail()
  }
}

// =============================================================================
// Dependency Tests
// =============================================================================

pub fn validate_spec_with_valid_dependency_test() {
  let behaviors = [
    make_behavior("login", [], "POST", "/auth/login", dict.new()),
    make_behavior("get_profile", ["login"], "GET", "/profile", dict.new()),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_with_missing_dependency_test() {
  let behavior =
    make_behavior(
      "get_profile",
      ["nonexistent_behavior"],
      "GET",
      "/profile",
      dict.new(),
    )
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(1)
      case list.first(issues) {
        Ok(validator.MissingDependency(_, "nonexistent_behavior")) -> Nil
        _ -> should.fail()
      }
    }
    _ -> should.fail()
  }
}

pub fn validate_spec_with_multiple_dependencies_test() {
  let behaviors = [
    make_behavior("setup", [], "POST", "/setup", dict.new()),
    make_behavior("login", ["setup"], "POST", "/auth/login", dict.new()),
    make_behavior(
      "get_profile",
      ["setup", "login"],
      "GET",
      "/profile",
      dict.new(),
    ),
  ]
  let spec = make_minimal_spec(behaviors)

  let result = validator.validate_spec(spec)

  result |> should.equal(validator.ValidationValid)
}

pub fn validate_spec_with_some_missing_dependencies_test() {
  let behavior =
    make_behavior(
      "complex",
      ["exists", "missing1", "missing2"],
      "GET",
      "/api",
      dict.new(),
    )
  let other = make_behavior("exists", [], "GET", "/exists", dict.new())
  let spec = make_minimal_spec([other, behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.length(issues) |> should.equal(2)
      // missing1 and missing2
    }
    _ -> should.fail()
  }
}

// =============================================================================
// Circular Dependency Tests
// =============================================================================

pub fn validate_spec_circular_dependency_self_test() {
  let behavior =
    make_behavior("circular", ["circular"], "GET", "/api", dict.new())
  let spec = make_minimal_spec([behavior])

  let result = validator.validate_spec(spec)

  case result {
    validator.ValidationInvalid(issues) -> {
      list.any(issues, fn(issue) {
        case issue {
          validator.CircularDependency(_) -> True
          _ -> False
        }
      })
      |> should.be_true()
    }
    _ -> should.fail()
  }
}

pub fn validate_spec_circular_dependency_two_behaviors_test() {
  let behaviors = [
    make_behavior("a", ["b"], "GET", "/a", dict.new()),
    make_behavior("b", ["a"], "GET", "/b", dict.new()),
