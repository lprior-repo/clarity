      ]),
    ], json.object)),
    #("rules", json.array([], json.object)),
    #("anti_patterns", json.array([], json.object)),
    #("ai_hints", json.object([
      #("implementation", json.object([])),
      #("entities", json.object([])),
      #("security", json.object([
        #("password_hashing", json.string("bcrypt")),
        #("jwt_algorithm", json.string("HS256")),
        #("jwt_expiry", json.string("1h")),
        #("rate_limiting", json.string("100/hour")),
      ])),
      #("pitfalls", json.array([], json.string)),
    ])),
  ])

  let result = parser.parse_spec(invalid_unicode_data)
  // Parser should handle invalid Unicode gracefully
  case result {
    Ok(_) -> should.be_true(True)
    Error(_) -> should.be_true(True)
  }
}

// Test 10: Performance benchmark
fn test_performance_benchmark() {
  // Test parser performance with various data sizes
  let sizes = [100, 1000, 5000]

  list.each(sizes, fn(size) {
    let data = create_performance_test_data(size)
    let start_time = system.monotonic_time()
    let result = parser.parse_spec(data)
    let end_time = system.monotonic_time()
    let elapsed = end_time - start_time

    // Performance should be reasonable (less than 1 second for small sizes)
    case result {
      Ok(_) ->
        if size <= 1000 {
          should.be_less_than(elapsed, 1000000000) // Less than 1 second
        } else {
          should.be_less_than(elapsed, 5000000000) // Less than 5 seconds for larger sizes
        }
      Error(_) -> should.be_true(True) // Graceful failure is acceptable
    }
  })
}

