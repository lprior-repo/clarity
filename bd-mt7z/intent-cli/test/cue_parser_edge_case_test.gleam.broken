            #("requires", json.array([], json.string)),
            #("tags", json.array([], json.string)),
            #("request", json.object([
              #("method", json.string("GET")),
              #("path", json.string("/performance")),
              #("headers", json.object([])),
              #("query", json.object([])),
              #("body", json.null()),
            ])),
            #("response", json.object([
              #("status", json.int(200)),
              #("example", json.object([
                #("items", items),
              ])),
              #("checks", json.object([
                #("performance_check", json.object([
