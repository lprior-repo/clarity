// Test 8: Memory stress test
fn test_memory_stress() {
  // Test parser with structures that might cause memory issues
  let memory_stress_data = create_memory_stress_data(10000) // Large data structure

  let result = parser.parse_spec(memory_stress_data)
  should.be_ok(result)
}

fn create_memory_stress_data(count: Int) -> dynamic.Dynamic {
  let items = list.range(1, count)
  |> list.map(fn(i) {
    json.object([
      #("id", json.int(i)),
      #("data", json.object([
        #("value", json.string(string.repeat("x", 100))),
        #("metadata", json.object([
          #("created_at", json.string("2023-01-01T00:00:00Z")),
          #("updated_at", json.string("2023-01-01T00:00:00Z")),
          #("tags", json.array([
            json.string("tag_" <> string.from_int(i)),
          ], json.string)),
        ])),
      ])),
    ])
  }, json.array)

  json.object([
    #("name", json.string("memory_stress_test")),
    #("description", json.string("Memory stress test")),
    #("audience", json.string("testers")),
    #("version", json.string("1.0.0")),
    #("success_criteria", json.array([json.string("Handle memory stress")], json.string)),
    #("config", json.object([
      #("base_url", json.string("http://example.com")),
      #("timeout_ms", json.int(5000)),
      #("headers", json.object([])),
    ])),
    #("features", json.array([
      json.object([
        #("name", json.string("memory_feature")),
        #("description", json.string("Memory stress feature")),
        #("behaviors", json.array([
          json.object([
            #("name", json.string("memory_behavior")),
            #("intent", json.string("Memory stress behavior")),
            #("notes", json.string("")),
            #("requires", json.array([], json.string)),
            #("tags", json.array([], json.string)),
            #("request", json.object([
              #("method", json.string("GET")),
              #("path", json.string("/memory")),
              #("headers", json.object([])),
              #("query", json.object([])),
              #("body", json.null()),
            ])),
            #("response", json.object([
              #("status", json.int(200)),
              #("example", json.object([
                #("items", items),
              ])),
              #("checks", json.object([
                #("memory_check", json.object([
                  #("rule", json.string("$.items.length == " <> string.from_int(count))),
                  #("why", json.string("Memory stress validation")),
                ])),
              ])),
            ])),
          ]),
        ], json.object)),
      ]),
    ], json.object)),
    #("rules", json.array([], json.object)),
    #("anti_patterns", json.array([], json.object)),
