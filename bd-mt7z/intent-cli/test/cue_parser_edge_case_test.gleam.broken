import gleam/dict
import gleam/json
import gleam/list
import gleam/result
import gleam/string
import gleeunit/should
import intent/parser
import intent/types

// ============================================================================
// CUE Parser Edge Case Test Suite
//
// This test suite focuses on specific edge cases that might break the parser
// ============================================================================

pub fn main() -> Nil {
  gleeunit.main()
}

// Test 1: Maximum recursion depth protection
fn test_maximum_recursion_depth() {
  // Test with deep nesting that might cause stack overflow
  let deep_data = create_very_deep_nesting(1000) // 1000 levels deep

  let result = parser.parse_spec(deep_data)

  // Parser should handle deep nesting gracefully (either succeed or fail gracefully)
  case result {
    Ok(_) -> should.be_true(True)
    Error(errors) -> should.be_true(True) // Expected to handle or fail gracefully
  }
}

fn create_very_deep_nesting(depth: Int) -> dynamic.Dynamic {
  let rec create_level = fn(current_depth: Int) -> dynamic.Dynamic {
    if current_depth <= 0 {
      json.object([#("value", json.string("deep"))])
    } else {
      json.object([#(
        "level_" <> string.from_int(current_depth),
        create_level(current_depth - 1),
      )])
    }
  }

  create_level(depth)
}

// Test 2: Circular reference detection
fn test_circular_references() {
  // Test parser with self-referential structures
  let circular_data = json.object([
    #("name", json.string("circular_test")),
    #("description", json.string("Circular reference test")),
    #("audience", json.string("testers")),
    #("version", json.string("1.0.0")),
    #("success_criteria", json.array([json.string("Handle circular references")], json.string)),
    #("config", json.object([
      #("base_url", json.string("http://example.com")),
      #("timeout_ms", json.int(5000)),
      #("headers", json.object([
        #("X-Circular", json.string("{{self.base_url}}")),
      ])),
    ])),
    #("features", json.array([
      json.object([
        #("name", json.string("circular_feature")),
        #("description", json.string("Circular feature")),
        #("behaviors", json.array([
          json.object([
            #("name", json.string("circular_behavior")),
            #("intent", json.string("Test circular reference")),
            #("notes", json.string("")),
            #("requires", json.array([json.string("self")], json.string)),
            #("tags", json.array([], json.string)),
            #("request", json.object([
              #("method", json.string("GET")),
              #("path", json.string("/circular/{{self.id}}")),
              #("headers", json.object([
                #("X-Reference", json.string("{{self.base_url}}")),
              ])),
              #("query", json.object([
                #("ref", json.string("{{self.config.base_url}}")),
              ])),
              #("body", json.object([
                #("circular_field", json.object([
                  #("reference", json.string("{{self.config.base_url}}")),
                ])),
              ])),
            ])),
            #("response", json.object([
              #("status", json.int(200)),
              #("example", json.object([
                #("result", json.string("circularResolved")),
              ])),
              #("checks", json.object([
                #("circular_check", json.object([
                  #("rule", json.string("$.result == 'circularResolved'")),
                  #("why", json.string("Circular reference resolved")),
                ])),
              ])),
            ])),
          ]),
        ], json.object)),
      ]),
    ], json.object)),
    #("rules", json.array([], json.object)),
    #("anti_patterns", json.array([], json.object)),
    #("ai_hints", json.object([
      #("implementation", json.object([])),
      #("entities", json.object([
        #("Circular", json.object([
          #("fields", json.object([
            #("id", json.string("string")),
            #("self_ref", json.string("string")),
          ])),
        ])),
      ])),
      #("security", json.object([
        #("password_hashing", json.string("bcrypt")),
        #("jwt_algorithm", json.string("HS256")),
        #("jwt_expiry", json.string("1h")),
        #("rate_limiting", json.string("100/hour")),
      ])),
      #("pitfalls", json.array([], json.string)),
    ])),
  ])

  let result = parser.parse_spec(circular_data)
  should.be_ok(result)
}

